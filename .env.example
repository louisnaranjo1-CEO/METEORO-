# ==============================================================================
# METEORO TRADER SOLANA — Environment Configuration (.env.example)
# Copy this file to `.env` and customize values before running the system.
# NEVER commit `.env` or real private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRADING MODE & SAFETY DUAL-LOCK
# ------------------------------------------------------------------------------
# Allowed modes: TUTORIAL | LIVE
TRADING_MODE=TUTORIAL
# Dual safety lock: MUST be explicitly set to `true` (alongside TRADING_MODE=LIVE
# and a valid LIVE_WALLET_PRIVATE_KEY) to broadcast real transactions on Solana.
ENABLE_LIVE_EXECUTION=false

# ------------------------------------------------------------------------------
# 2. TUTORIAL MODE — REALISTIC SOL BANKROLL & FRICTION SIMULATION
# ------------------------------------------------------------------------------
# Virtual starting bankroll denominated in SOL
TUTORIAL_INITIAL_BANKROLL_SOL=5.0
# Fixed entry size per approved trade in SOL (Gate never scales size by Judge confidence)
TRADE_SIZE_SOL=0.25
# Simulated DEX swap fee percentage (e.g. Raydium/PumpSwap/Meteora ~0.25%)
SIM_DEX_FEE_PCT=0.25
# Simulated Solana priority fee per transaction in SOL
SIM_PRIORITY_FEE_SOL=0.0005
# Simulated Jito validator tip per transaction in SOL
SIM_JITO_TIP_SOL=0.002
# Simulated Solana base signature fee per transaction in SOL
SIM_BASE_NETWORK_FEE_SOL=0.000005
# Asymmetric slippage model (%) applied by order scenario
SIM_BUY_SLIPPAGE_PCT=1.5
SIM_TP_SLIPPAGE_PCT=2.0
SIM_SL_SLIPPAGE_PCT=8.0
# Fallback SOL/USD price used only if live SOL quote feed is unreachable at boot
FALLBACK_SOL_USD_PRICE=180.0

# ------------------------------------------------------------------------------
# 3. PHASE 1 & 2 — SEARCH (DEXSCREENER) & HARD RISK THRESHOLDS (RUGCHECK)
# ------------------------------------------------------------------------------
SEARCH_INTERVAL_SECONDS=15
MIN_MARKET_CAP_USD=50000.0
MAX_MARKET_CAP_USD=1500000.0
MIN_LIQUIDITY_USD=12000.0
MIN_HOLDERS=150

# Hard Risk Filter instant-kill rules
REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
REQUIRE_LP_LOCKED_OR_BURNED=true
MAX_TOP10_HOLDERS_PCT=25.0
MAX_DEV_WALLET_PCT=4.0
# Primary pool must hold >= 80% of total token liquidity (else FRAGMENTED_LIQUIDITY)
MAIN_POOL_LIQUIDITY_SHARE_MIN=0.80

# ------------------------------------------------------------------------------
# 4. PHASE 3 — WHALE TRACKING & HELIUS RPC
# ------------------------------------------------------------------------------
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SMART_WALLETS_PATH=data/smart_wallets.json
# Fallback organic buyer activity threshold when no tracked whale wallet is present
ORGANIC_FALLBACK_MIN_UNIQUE_MAKERS_5M=45

# ------------------------------------------------------------------------------
# 5. PHASE 5 — MUTE JUDGE (OPENROUTER — ZERO PROSE, STRICT JSON)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=google/gemini-2.0-flash-001
# Locked at 0.0 for deterministic structured output
JUDGE_TEMPERATURE=0.0
# Any timeout or malformed response defaults strictly to action="pass"
JUDGE_TIMEOUT_SECONDS=8.0

# ------------------------------------------------------------------------------
# 6. PHASE 6 — DETERMINISTIC GATE & CIRCUIT BREAKERS
# ------------------------------------------------------------------------------
# Tokens below $150K Market Cap require stricter Judge probability thresholds
LOW_MCAP_THRESHOLD_USD=150000.0

# Confirmed Zone thresholds ($150K to $1.5M)
GATE_MIN_ACTION_PROB=0.70
GATE_MIN_ORGANIC_PROB=0.65
GATE_MAX_LATE_PROB=0.45
GATE_MAX_EXIT_RISK=3
GATE_MAX_EXIT_RISK_PROB=0.35
GATE_MAX_MANIPULATION_PROB=0.30

# Early Zone thresholds ($50K to $149,999)
GATE_MIN_ACTION_PROB_LOW_MCAP=0.75
GATE_MIN_ORGANIC_PROB_LOW_MCAP=0.75
GATE_MAX_LATE_PROB_LOW_MCAP=0.30
GATE_MAX_EXIT_RISK_PROB_LOW_MCAP=0.22
GATE_MAX_MANIPULATION_PROB_LOW_MCAP=0.20

# Single re-evaluation window when Judge returns action="watch"
WATCH_RECHECK_MINUTES=4

# Portfolio, Liquidity Impact & Circuit Breaker limits
MAX_CONCURRENT_TRADES=3
MAX_DAILY_LOSS_SOL=0.75
MAX_DAILY_LOSS_PCT=10.0
MAX_CONSECUTIVE_SL=3
# Trade entry USD must not exceed 1.0% of pool liquidity USD
MAX_ENTRY_LIQUIDITY_PCT=1.0

# ------------------------------------------------------------------------------
# 7. PHASE 8 — VOLUMETRIC EXIT ENGINE & SEMI-AUTO APPROVAL
# ------------------------------------------------------------------------------
EXIT_POLL_INTERVAL_SECONDS=15
# Initial hard Stop Loss from entry (-22%)
INITIAL_STOP_LOSS_PCT=22.0
# TP1 partial take profit (+45% -> sell 50% -> raise Stop Loss to +5% net break-even)
TP1_TRIGGER_PCT=45.0
TP1_SELL_PCT=50.0
TP1_BREAKEVEN_SL_PCT=5.0
# Full capital recovery trigger (+100% / 2x -> transition to RISK_FREE_RUNNER)
FREE_RISK_TRIGGER_PCT=100.0
TP1_MULTIPLIER=2.0
# Dynamic trailing stop pullback (%) from peak price in RISK_FREE_RUNNER
TRAILING_STOP_PCT=18.0
TRAILING_STOP_X_BOOST_PCT=24.0
# Stagnation kill: flat price (< 8% band) + volume < 35% of peak 5m volume
STAGNATION_WINDOW_MINUTES=12
STAGNATION_RUNNER_WINDOW_MINUTES=20
STAGNATION_PRICE_BAND_PCT=8.0
STAGNATION_VOLUME_FLOOR_PCT=35.0
STAGNATION_MAX_MINUTES=20
STAGNATION_VOLUME_DROP_PCT=60.0
# Extreme sell pressure kill: sells_5m / buys_5m >= 3.0 for 2 consecutive cycles
SELL_RATIO_KILL_MULTIPLIER=3.0
SELL_RATIO_KILL_CONSECUTIVE_CYCLES=2
SELL_RATIO_KILL_THRESHOLD=0.72
# Emergency LP drain panic: liquidity drop > 25% in < 2 minutes (auto-blacklist if <= 15m)
LIQUIDITY_PANIC_DROP_PCT=25.0
LIQUIDITY_PANIC_WINDOW_SECONDS=120
LIQUIDITY_PANIC_BLACKLIST_MAX_AGE_MINUTES=15
# Semi-auto mode approval timeout (seconds)
SEMI_AUTO_APPROVAL_TIMEOUT_SECONDS=90

# ------------------------------------------------------------------------------
# 8. OPTIONAL X (TWITTER) CATALYST RADAR (VOLUME ALWAYS OVERRIDES SOCIAL)
# ------------------------------------------------------------------------------
# Checked ONLY on RISK_FREE_RUNNER positions when enabled
ENABLE_X_CONTEXT_ON_RUNNER=false
X_API_URL=
X_API_KEY=
X_TIMEOUT_SECONDS=2.5
X_CACHE_TTL_SECONDS=180
X_NOTABLE_MIN_FOLLOWERS=50000
NOTABLE_ACCOUNTS_PATH=data/notable_accounts.json
X_RADAR_ENABLED=false
X_BEARER_TOKEN=
X_MIN_VOLUME_1H_USD=100000.0

# ------------------------------------------------------------------------------
# 9. PHASE 9 — TELEGRAM ALERTS, NIGHTLY AUDIT (21:00) & SUNDAY CALIBRATION
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NIGHTLY_REPORT_HOUR=21
NIGHTLY_REPORT_MINUTE=0
SYSTEM_TIMEZONE=America/Caracas

# ------------------------------------------------------------------------------
# 10. STORAGE, FASTAPI & COMMAND CENTER AUTH
# ------------------------------------------------------------------------------
DATABASE_PATH=data/desk.db
LOG_DIR=logs
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PIN required for state-changing actions in the Command Center (pause, mode, blacklist)
DASHBOARD_PIN=

# ------------------------------------------------------------------------------
# 11. LIVE EXECUTION — JUPITER + JITO + DEDICATED WALLET (EMPTY BY SECURITY)
# ------------------------------------------------------------------------------
# Base58 private key (or 64-byte JSON array) of a DEDICATED hot wallet
# (never use your main vault wallet). LIVE_WALLET_PRIVATE_KEY is accepted as alias.
SOLANA_PRIVATE_KEY=
LIVE_WALLET_PRIVATE_KEY=
LIVE_WALLET_PUBLIC_KEY=
MAX_LIVE_TRADE_SOL=0.50
MIN_LIVE_GAS_RESERVE_SOL=0.15
JUPITER_API_BASE_URL=https://quote-api.jup.ag/v6
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
LIVE_PRIORITY_FEE_LAMPORTS=500000
LIVE_JITO_TIP_LAMPORTS=2000000
LIVE_BUY_SLIPPAGE_BPS=150
LIVE_TP_SLIPPAGE_BPS=200
LIVE_SL_SLIPPAGE_BPS=800
# Optional port exposed by Nginx reverse proxy in docker-compose.yml
DASHBOARD_PORT=8080
